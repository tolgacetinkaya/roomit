{
  "app": {
    "windows": [{
      "label": "main",
      "title": "Roomit",
      "theme": "Dark",
      "backgroundColor": "#181b20",
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "width": 1280,
      "height": 860,
      "minWidth": 720,
      "minHeight": 600
    }]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://raw.githubusercontent.com/tolgacetinkaya/roomit/macos-updates/latest-macos.json"]
    }
  }
}
